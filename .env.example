# ===========================================
# StitchGuard - Configuração
# ===========================================

# PostgreSQL (produção)
DATABASE_URL=sqlite:///stitchguard_dev.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/stitchguard

# JWT (mude em produção!)
JWT_SECRET_KEY=dev-secret-change-in-production-use-openssl-rand-hex-32

# Asaas (Billing)
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox

# Google Drive (Entrega)
GOOGLE_DRIVE_CREDENTIALS=
GOOGLE_DRIVE_FOLDER_ID=

# SMTP (Notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=StitchGuard <noreply@stitchguard.com.br>

# Redis (Fila)
REDIS_URL=redis://localhost:6379

# S3/MinIO (Armazenamento)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=stitchguard
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# App
ENVIRONMENT=development
API_PORT=8000
BASE_URL=http://localhost:8000
